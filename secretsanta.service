[Unit]
Description=Secret Santa Family Web App
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/secretsanta
ExecStart=/usr/bin/python3 /opt/secretsanta/server.py
Restart=always
RestartSec=5
Environment=PORT=8082
Environment=HOST=0.0.0.0
Environment=SECRETSANTA_DB=/opt/secretsanta/data/secretsanta.db

# Hardening / Sandboxing options for systemd
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# Secret Santa Environment Configuration

# Server network settings
PORT=8082
HOST=0.0.0.0

# Database path (stored in data/ for persistence)
SECRETSANTA_DB=/opt/secretsanta/data/secretsanta.db

# Family Registration Passcode:
# Set this to a password/passphrase that family members must enter to register.
# This prevents random strangers on the internet from creating accounts.
# Example: REGISTRATION_PASSPHRASE=ChristmasCheer2026!
REGISTRATION_PASSPHRASE=

# Session cookie "Secure" flag:
#   auto  (default) - set Secure when the request arrived over HTTPS via the reverse proxy
#                     (X-Forwarded-Proto: https, sent by Caddy and Nginx Proxy Manager)
#   true            - always set Secure (cookie only sent over HTTPS)
#   false           - never set Secure (plain-HTTP LAN testing only)
COOKIE_SECURE=auto

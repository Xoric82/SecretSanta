# Caddyfile for Secret Santa Homelab Deployment
# Replace "santa.homelab.local" or "santa.yourdomain.com" with your actual domain or internal DNS.

santa.homelab.local {
    # If using local HTTPS or public domain, Caddy automatically provisions certificates.
    # For internal-only homelab domains without public DNS, you can use internal TLS:
    # tls internal

    # Reverse proxy to the Secret Santa backend on port 8080
    reverse_proxy 127.0.0.1:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Optional: Enable gzip/zstd compression
    encode zstd gzip

    # Access logs
    log {
        output file /var/log/caddy/secretsanta_access.log
    }
}
